# ==========================================
# Prism Review - Environment Configuration
# ==========================================

# Server & Runtime Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# GitHub App Authentication
# Private key can be provided as a filesystem path or encoded content
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=

# Database & Vector Store (PostgreSQL + pgvector)
POSTGRES_USER=prism
POSTGRES_PASSWORD=prism
POSTGRES_DB=prism
POSTGRES_PORT=5432
DATABASE_URL=postgresql://prism:prism@localhost:5432/prism

# Redis (Job Queue & Cache)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# LLM Providers & Timeouts
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_TIMEOUT_SECONDS=30.0

# Observability & Tracing (Optional - Langfuse)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
